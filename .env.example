# ESET Connect API user (ESET PROTECT Hub / Business Account, "Integrations" right)
ESET_USER=api-user@example.com
# ESET_PASS is read from .pwd (docker secret), see docker-compose.yml
ESET_REGION=eu

# Graylog GELF input
GRAYLOG_HOST=host.docker.internal
GRAYLOG_PORT=12201
GRAYLOG_PROTO=tcp

# sync every 15 minutes
INTERVAL_SECONDS=900
# security events (Incident Management v3)
SHIP_INDICATORS=true
SHIP_INCIDENTS=true
# indicators window on the very first run (ESET keeps ~30 days)
LOOKBACK_HOURS=24
