# ESET Connect API user (ESET PROTECT Hub / Business Account, "Integrations" right)
ESET_USER=api-user@example.com
# ESET_PASS is read from .pwd (docker secret), see docker-compose.yml
ESET_REGION=eu

# Graylog GELF input (dedicated input "eset-protect-gelf-tcp")
GRAYLOG_HOST=host.docker.internal
GRAYLOG_PORT=13301
GRAYLOG_PROTO=tcp

# sync every 15 minutes; also ship new detections
INTERVAL_SECONDS=900
SHIP_DETECTIONS=true
# detections window on the very first run
# (pass --lookback-hours via `command:` in compose to change, default 24)
